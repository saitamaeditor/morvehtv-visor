# Opcional: si no existe .env, el visor usa las credenciales de ../fotograma/api/.env
E2_ENDPOINT=https://s3.eu-central-2.idrivee2.com
E2_REGION=eu-central-2
E2_BUCKET=
E2_ACCESS_KEY_ID=
E2_SECRET_ACCESS_KEY=
VISOR_PUERTO=4010

# Otros dispositivos de casa (móvil, tablet, smart TV) entran con este PIN.
# Si no lo pones, se genera uno al azar y se guarda en data/pin.txt
VISOR_PIN=
# Pon 1 para que solo se pueda usar desde este ordenador
VISOR_SOLO_LOCAL=0
