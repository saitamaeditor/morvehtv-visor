<?xml version="1.0" encoding="utf-8"?>
<!-- Reproductor nativo: el vídeo a pantalla completa, arriba «‹ Volver» y el título, y abajo los
     botones a la izquierda (idioma, ▶, ⟲10, 10⟳, ⛶) seguidos de la barra de progreso -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/vista"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false" />

    <ProgressBar
        android:id="@+id/cargando"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="#8E4EC6"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/grande"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:background="@drawable/boton_grande"
        android:contentDescription="Reproducir"
        android:padding="24dp"
        android:paddingStart="28dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_play" />

    <TextView
        android:id="@+id/mensaje"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="100dp"
        android:background="#B3000000"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/arriba"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/degradado_arriba"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <Button
            android:id="@+id/volver"
            style="@style/BotonReproductor"
            android:text="‹  Volver" />

        <TextView
            android:id="@+id/titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#000000"
            android:shadowRadius="6"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/degradado_abajo"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="36dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <!-- Iconos dibujados (no símbolos de texto: muchas teles no tienen esas letras) -->
        <Button
            android:id="@+id/audio"
            style="@style/BotonReproductor"
            android:drawableStart="@drawable/ic_audio"
            android:drawablePadding="6dp"
            android:text="SPA" />
        <ImageButton android:id="@+id/play" style="@style/BotonIcono" android:contentDescription="Reproducir o pausar" android:src="@drawable/ic_play" />
        <Button
            android:id="@+id/atras"
            style="@style/BotonReproductor"
            android:contentDescription="Retroceder 10 segundos"
            android:drawableStart="@drawable/ic_atras"
            android:drawablePadding="4dp"
            android:text="10" />
        <Button
            android:id="@+id/adelante"
            style="@style/BotonReproductor"
            android:contentDescription="Adelantar 10 segundos"
            android:drawableEnd="@drawable/ic_adelante"
            android:drawablePadding="4dp"
            android:text="10" />
        <ImageButton android:id="@+id/salir" style="@style/BotonIcono" android:contentDescription="Salir de pantalla completa" android:src="@drawable/ic_salir_pantalla" />

        <SeekBar
            android:id="@+id/barra"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:focusable="false"
            android:progressTint="#8E4EC6"
            android:thumbTint="#FFFFFF" />

        <TextView
            android:id="@+id/tiempo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="0:00 / 0:00"
            android:textColor="#E7E9EE"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
